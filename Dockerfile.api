# 使用 PyTorch 官方镜像，已包含 CUDA 支持
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# 设置工作目录
WORKDIR /app

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install system deps used by audio pipeline and healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=5 \
    --fix-missing \
    tzdata \
    ffmpeg \
    git \
    curl \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# Base image already includes torch/torchaudio; skip reinstalling huge wheels.
RUN grep -Ev "^(torch|torchaudio|openai-whisper)([<>=!].*)?$" requirements.txt > requirements.runtime.txt \
    && pip install --no-cache-dir -r requirements.runtime.txt \
    && pip install --no-cache-dir openai-whisper \
    && rm -f requirements.runtime.txt

# 复制源代码
COPY server.py .
COPY score_reading/ ./score_reading/

# 创建数据目录
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/config || exit 1

# 启动命令
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
