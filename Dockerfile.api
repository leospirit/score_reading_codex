# 使用 PyTorch 官方镜像，已包含 CUDA 支持
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# 设置工作目录
WORKDIR /app

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install system deps used by audio pipeline and healthcheck.
# Use Node 20 so yt-dlp JS challenge solver stays compatible.
RUN apt-get update && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=5 \
    --fix-missing \
    tzdata \
    ffmpeg \
    git \
    curl \
    ca-certificates \
    gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# Base image already includes torch/torchaudio; skip reinstalling huge wheels.
RUN tr -d '\r' < requirements.txt | grep -Ev "^(torch|torchaudio|openai-whisper)([<>=!].*)?$" > requirements.runtime.txt \
    && pip install --no-cache-dir --default-timeout=180 --retries 8 -r requirements.runtime.txt \
    && pip install --no-cache-dir --default-timeout=180 --retries 8 --no-build-isolation openai-whisper \
    && rm -f requirements.runtime.txt

# 复制源代码
COPY server.py .
COPY score_reading/ ./score_reading/

# 创建数据目录
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/config || exit 1

# 启动命令
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
