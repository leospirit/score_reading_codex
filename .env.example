# Backend keys (set what you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_API_BASE=
AZURE_API_KEY=
YOUTUBE_API_KEY=
YTDLP_PO_TOKENS=

# Optional backend protection / CORS
ADMIN_API_TOKEN=
# Example: http://localhost,http://127.0.0.1,http://localhost:5173
CORS_ALLOW_ORIGINS=
# Max upload size in MB (backend validation), default 30
UPLOAD_MAX_MB=30
# Warn only (no auto-delete) when uploads dir exceeds this size in GB, default 20
UPLOAD_STORAGE_WARN_GB=20

# Frontend build-time API host
# Leave empty to use same-origin (/api via nginx proxy in Docker).
# Example for local dev outside Docker: http://localhost:8000
VITE_API_HOST=

# Analytics PG sidecar (phase 1)
# Example: postgresql://user:password@127.0.0.1:5432/speech_analytics
PG_ANALYTICS_DSN=
PG_USER=speech
PG_PASSWORD=speech123
PG_DB=speech_analytics
