                        <div style="font-size:0.78rem; color:#6D28D9; font-weight:800; text-transform:uppercase; letter-spacing:.4px;">Hesitation subscore</div>
                        <div style="font-size:1.15rem; color:#0F172A; font-weight:800; margin-top:3px;">{{ ('%.1f' % (hesitation_display_score | float)).rstrip('0').rstrip('.') if hesitation_display_score is not none else '--' }}</div>
                        <div style="font-size:0.8rem; color:#64748B; margin-top:2px;">Weight in fluency: 10%</div>
