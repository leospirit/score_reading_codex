        .skill-card.intonation { border-top-color: #00C853; }
        .skill-card.fluency { border-top-color: #FF9100; }
        .skill-card.completeness { border-top-color: #AA00FF; }
        
        .skill-score {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 10px 0;
            line-height: 1;
        }
        
