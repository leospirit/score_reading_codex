                 {% set pace_display_score = (fluency_components.pace_score if fluency_components and fluency_components.pace_score is defined else None) %}
                 {% set hesitation_display_score = (fluency_components.hesitation_score if fluency_components and fluency_components.hesitation_score is defined else None) %}

                 <div style="display:flex; gap:12px; flex-wrap:wrap; margin: 4px 0 8px 0;">
