                        <div style="font-size:1.15rem; color:#0F172A; font-weight:800; margin-top:3px;">{{ ('%.1f' % (pace_display_score | float)).rstrip('0').rstrip('.') if pace_display_score is not none else '--' }}</div>
                        <div style="font-size:0.8rem; color:#64748B; margin-top:2px;">Weight in fluency: 18%</div>
                    </div>
