                        <div style="font-size:1.15rem; color:#0F172A; font-weight:800; margin-top:3px;">{{ ('%.1f' % (pausing_display_score | float)).rstrip('0').rstrip('.') }}</div>
                        <div style="font-size:0.8rem; color:#64748B; margin-top:2px;">Weight in fluency: 72%</div>
