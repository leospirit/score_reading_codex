                                            {% set issue_cls = 'too-long' %}
                                            {% set issue_tip = 'After ' ~ left_word ~ ' before ' ~ right_word ~ ': pause too long (' ~ actual_ms ~ ' ms). Target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms. Shorten by about ' ~ adjust_ms ~ ' ms.' %}
                                            {% set issue_print = 'shorten ~' ~ adjust_ms ~ ' ms (target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms)' %}
                                            {% set student_title = 'Too Long: shorten this pause' %}
                                            {% set expected_pause_type = (focus.item.pause_type | default('') | lower) %}
                                            {% set linked_next = (loop.nextitem is defined and (loop.nextitem.is_linked | default(false))) %}
                                            {% set phrase_break = false %}
                                            {% if expected_pause_type in ['none', 'light', 'medium'] or linked_next %}
                                                {% set phrase_break = true %}
                                            {% endif %}
                                            {% if phrase_break %}
                                                {% set issue_label = 'LONG PAUSE' %}
                                                {% set issue_cls = 'phrase-break' %}
                                                {% set issue_tip = 'After ' ~ left_word ~ ' before ' ~ right_word ~ ': this pause is too long and breaks a connected phrase (' ~ actual_ms ~ ' ms). Keep the phrase connected; target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms.' %}
                                                {% set issue_print = 'phrase split: connect words; shorten ~' ~ adjust_ms ~ ' ms' %}
                                                {% set student_title = 'Phrase Break: keep these words connected' %}
                                            {% endif %}
                                        {% endif %}
                                        <span class="pause-guide-tag inline {{ issue_cls }}"
                                              title="{{ issue_tip }}"
                                              data-student-title="{{ student_title }}"
                                              data-print-hint="{{ issue_print }}">
                                            {{ issue_label }}
                                        </span>
                                    {% endif %}
                                {% elif word.pause %}
                                    {% set pause_issue = (word.pause.issue | default('') | lower) %}
                                    {% if pause_issue == '' %}
                                        {% if word.pause.type == 'bad' %}
                                            {% set pause_issue = 'too_long' %}
                                        {% elif word.pause.type == 'missed' %}
                                            {% set pause_issue = 'too_short' %}
                                        {% endif %}
                                    {% endif %}
                                    {% if pause_issue == 'too_long' %}
                                        {% set right_word = loop.nextitem.word if loop.nextitem is defined else 'next word' %}
                                        {% set actual_ms = ((word.pause.duration | default(0) | float) * 1000) | round | int %}
                                        {% set target_min_ms = ((word.pause.target_min | default(0) | float) * 1000) | round | int %}
                                        {% set target_max_ms = ((word.pause.target_max | default(0) | float) * 1000) | round | int %}
                                        {% set adjust_ms = ((word.pause.adjust_sec | default(0) | float) * 1000) | round | int %}
                                        {% set issue_label = 'TOO SHORT' %}
                                        {% set issue_cls = 'too-short' %}
                                        {% set issue_tip = 'After ' ~ word.word ~ ' before ' ~ right_word ~ ': pause too short (' ~ actual_ms ~ ' ms). Target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms. Add about ' ~ adjust_ms ~ ' ms.' %}
                                        {% set issue_print = 'add ~' ~ adjust_ms ~ ' ms (target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms)' %}
                                        {% set student_title = 'Too Short: add a clearer pause here' %}
                                        {% if pause_issue == 'too_long' %}
                                            {% set issue_label = 'LONG PAUSE' %}
                                            {% set issue_cls = 'too-long' %}
                                            {% set issue_tip = 'After ' ~ word.word ~ ' before ' ~ right_word ~ ': pause too long (' ~ actual_ms ~ ' ms). Target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms. Shorten by about ' ~ adjust_ms ~ ' ms.' %}
                                            {% set issue_print = 'shorten ~' ~ adjust_ms ~ ' ms (target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms)' %}
                                            {% set student_title = 'Too Long: shorten this pause' %}
                                            {% set expected_pause_type = (word.pause.expected_type | default('') | lower) %}
                                            {% set linked_next = (loop.nextitem is defined and (loop.nextitem.is_linked | default(false))) %}
                                            {% set phrase_break = false %}
                                            {% if expected_pause_type in ['none', 'light', 'medium'] or linked_next %}
                                                {% set phrase_break = true %}
                                            {% endif %}
                                            {% if phrase_break %}
                                                {% set issue_label = 'LONG PAUSE' %}
                                                {% set issue_cls = 'phrase-break' %}
                                                {% set issue_tip = 'After ' ~ word.word ~ ' before ' ~ right_word ~ ': this pause is too long and breaks a connected phrase (' ~ actual_ms ~ ' ms). Keep the phrase connected; target ' ~ target_min_ms ~ '-' ~ target_max_ms ~ ' ms.' %}
                                                {% set issue_print = 'phrase split: connect words; shorten ~' ~ adjust_ms ~ ' ms' %}
                                                {% set student_title = 'Phrase Break: keep these words connected' %}
                                            {% endif %}
                                        {% endif %}
                                        <span class="pause-guide-tag inline {{ issue_cls }}"
                                              title="{{ issue_tip }}"
                                              data-student-title="{{ student_title }}"
                                              data-print-hint="{{ issue_print }}">
                                            {{ issue_label }}
                                        </span>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                 </div>
                 <div id="tab-pace" class="tab-content">
                    {% set avg_wpm = 0 %}
