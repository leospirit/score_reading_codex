    <script>
        // Modal Control
                window.openIntonationModal = function() {
            document.getElementById('intonationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            renderIntonationRhythm();
        }

        window.closeIntonationModal = function() {
            document.getElementById('intonationModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        function splitIntoIntonationSentences(words) {
            const chunks = [];
            let current = [];

            for (let i = 0; i < words.length; i++) {
                const w = words[i] || {};
                current.push(w);

                const pause = w.pause || null;
                const pauseDuration = pause ? Number(pause.duration || 0) : 0;
                const byPause = pauseDuration >= 0.38;
                const byLength = current.length >= 16;
                const isLast = i === words.length - 1;

                if (byPause || byLength || isLast) {
                    if (current.length >= 4) chunks.push(current);
                    current = [];
                }
            }

            if (!chunks.length && words.length) chunks.push(words);
            return chunks;
        }

        function inferExpectedStressByWord(wordText) {
            const token = String(wordText || '').toLowerCase().replace(/[^a-z']/g, '');
            if (!token) return false;
            const functionWords = new Set([
                'a', 'an', 'the', 'of', 'in', 'on', 'at', 'to', 'for', 'with', 'by',
                'is', 'are', 'am', 'was', 'were', 'be', 'been', 'being',
                'and', 'or', 'but', 'so', 'if', 'as', 'than', 'that', 'this', 'these', 'those',
                'i', 'you', 'he', 'she', 'it', 'we', 'they', 'me', 'him', 'her', 'us', 'them',
                'my', 'your', 'his', 'its', 'our', 'their',
                'do', 'does', 'did', 'can', 'could', 'will', 'would', 'shall', 'should',
                'have', 'has', 'had', 'not', 'no', 'yes', 'oh', 'too'
            ]);
            return !functionWords.has(token);
        }

        function quantile(values, q) {
            if (!Array.isArray(values) || !values.length) return 0;
            const sorted = [...values].sort((a, b) => a - b);
            const pos = Math.max(0, Math.min(sorted.length - 1, Math.round((sorted.length - 1) * q)));
            return sorted[pos];
        }

        function classifyStressToken(word, cutoff) {
            const rawExpected = Number(word.expected_stress);
            const expected = Number.isFinite(rawExpected)
                ? rawExpected >= 0.62
                : inferExpectedStressByWord(word.word);

            const stressVal = Number(word.stress ?? 0);
            const scoreVal = Number(word.score ?? 0);
            const inferredStress = stressVal > 0.01
                ? Math.max(0, Math.min(1, stressVal))
                : Math.max(0, Math.min(1, scoreVal / 100));
            const actual = inferredStress >= cutoff;
            const tag = String(word.tag || '').toLowerCase();
            const isMissing = tag === 'missing';
            const isPoor = tag === 'poor';

            if (expected) {
                if (actual && !isMissing && !isPoor) {
                    return { bubbleClass: 'ok stressed', wordClass: '', accurate: true, stressed: true, inferredStress };
                }
                return { bubbleClass: 'bad stressed', wordClass: 'bad', accurate: false, stressed: true, inferredStress };
            }

            if (actual && !isMissing && !isPoor) {
                // Over-stress on a likely function/light word.
                return { bubbleClass: 'bad light', wordClass: 'bad', accurate: false, stressed: false, inferredStress, overStress: true };
            }
            return { bubbleClass: 'silver light', wordClass: '', accurate: true, stressed: false, inferredStress, overStress: false };
        }

        function evaluateSentence(words) {
            const tokens = [];
            let stressTargets = 0;
            let stressCorrect = 0;
            const rawStress = words.map((w) => {
                const s = Number(w.stress ?? 0);
                const sc = Number(w.score ?? 0);
                return s > 0.01 ? Math.max(0, Math.min(1, s)) : Math.max(0, Math.min(1, sc / 100));
            });
            const minStress = rawStress.length ? Math.min(...rawStress) : 0;
            const maxStress = rawStress.length ? Math.max(...rawStress) : 1;
            const spread = maxStress - minStress;
            const q68 = quantile(rawStress, 0.68);
            const cutoff = Math.max(0.56, Math.min(0.82, q68 + (spread < 0.06 ? 0.03 : 0)));

            words.forEach((w) => {
                const cls = classifyStressToken(w, cutoff);
                if (cls.stressed) {
                    stressTargets += 1;
                    if (cls.accurate) stressCorrect += 1;
                }
                tokens.push({ word: w.word, cls });
            });

            const baseAccuracy = stressTargets > 0 ? Math.round((stressCorrect / stressTargets) * 100) : 0;
            const stressedVals = tokens.filter((t) => t.cls.stressed).map((t) => Number(t.cls.inferredStress || 0));
            const lightVals = tokens.filter((t) => !t.cls.stressed).map((t) => Number(t.cls.inferredStress || 0));
            const missedStressCount = tokens.filter((t) => t.cls.stressed && !t.cls.accurate).length;
            const overStressCount = tokens.filter((t) => t.cls.overStress).length;
            const mean = (arr) => arr.length ? (arr.reduce((a, b) => a + b, 0) / arr.length) : 0;
            const contrast = stressedVals.length && lightVals.length ? (mean(stressedVals) - mean(lightVals)) : 0;
            let penalty = 0;
            if (stressTargets >= 2) {
                if (contrast < 0.06) penalty += 25;
                else if (contrast < 0.10) penalty += 14;
                else if (contrast < 0.14) penalty += 7;
            }
            if (spread < 0.05) penalty += 8;
            penalty += Math.min(18, overStressCount * 5);
            const accuracy = Math.max(0, Math.min(100, baseAccuracy - penalty));
            let issueScore = 0;
            issueScore += missedStressCount * 3;
            issueScore += overStressCount * 2;
            if (contrast < 0.06) issueScore += 3;
            else if (contrast < 0.10) issueScore += 2;
            else if (contrast < 0.14) issueScore += 1;
            if (spread < 0.05) issueScore += 1;
            if (accuracy < 70) issueScore += 2;
            else if (accuracy < 85) issueScore += 1;
            return {
                words,
                tokens,
                text: words.map((w) => w.word).join(' '),
                stressTargets,
                stressCorrect,
                missedStressCount,
                accuracy,
                contrast,
                spread,
                overStressCount,
                issueScore,
            };
        }

        function pickBestAndWorst(sentenceStats) {
            const analyzable = sentenceStats.filter((s) => Number(s.stressTargets || 0) >= 2);
            const pool = analyzable.length ? analyzable : sentenceStats;
            const sorted = [...pool].sort((a, b) => {
                if (b.accuracy !== a.accuracy) return b.accuracy - a.accuracy;
                return b.stressCorrect - a.stressCorrect;
            });

            const best = sorted[0] || null;
            const bestText = best ? best.text : null;
            let candidates = pool.filter((s) => !bestText || s.text !== bestText);
            if (!candidates.length) candidates = pool;
            const issueCandidates = candidates.filter((s) => Number(s.issueScore || 0) > 0);
            const worstPool = issueCandidates.length ? issueCandidates : candidates;
            const worst = [...worstPool].sort((a, b) => {
                if ((b.issueScore || 0) !== (a.issueScore || 0)) return (b.issueScore || 0) - (a.issueScore || 0);
                if (a.accuracy !== b.accuracy) return a.accuracy - b.accuracy;
                if ((b.missedStressCount || 0) !== (a.missedStressCount || 0)) return (b.missedStressCount || 0) - (a.missedStressCount || 0);
                return b.stressTargets - a.stressTargets;
            })[0] || best;
            return { best, worst };
        }

        function deriveIntonationIssue(stat) {
            const under = stat.tokens
                .filter((t) => t.cls.stressed && !t.cls.accurate)
                .map((t) => String(t.word || '').toLowerCase());
            const over = stat.tokens
                .filter((t) => t.cls.overStress)
                .map((t) => String(t.word || '').toLowerCase());
            const miss = [...new Set(under)].filter(Boolean).slice(0, 3);
            const overUniq = [...new Set(over)].filter(Boolean).slice(0, 3);

            if (miss.length) {
                return {
                    title: `Key issue: missed stress on ${miss.join(' / ')}`,
                    action: 'Fix: lengthen each focus word by about 0.1-0.2s and raise pitch slightly on its vowel.',
                };
            }
            if (overUniq.length) {
                return {
                    title: `Key issue: over-stressed light words ${overUniq.join(' / ')}`,
                    action: 'Fix: keep these words shorter and lighter; move emphasis back to content words.',
                };
            }
            if (Number(stat.contrast || 0) < 0.10) {
                return {
                    title: 'Key issue: stress contrast is too flat in this sentence',
                    action: 'Fix: keep 2-4 key stresses and reduce energy on connecting words.',
                };
            }
            return {
                title: 'Key issue: rhythm control is unstable in this sentence',
                action: 'Fix: read once slowly with marked stress words, then repeat at normal pace.',
            };
        }

        function buildCard(stat, variant) {
            const title = variant === 'best' ? 'Best Performance' : 'Needs Improvement';
            const issue = deriveIntonationIssue(stat);
            const note = variant === 'best'
                ? 'Stress rhythm is accurate and natural. Keep it up.'
                : `${issue.title}. ${issue.action}`;

            const cardClass = variant === 'best' ? 'intonation-card best' : 'intonation-card warning';
            const titleClass = variant === 'best' ? 'intonation-title best' : 'intonation-title warning';
            const accClass = variant === 'best' ? 'intonation-acc best' : 'intonation-acc warning';
            const tokenHtml = stat.tokens.map((t) => `
                <span class="intonation-token">
                    <span class="stress-bubble ${t.cls.bubbleClass}"></span>
                    <span class="intonation-word ${t.cls.wordClass}">${t.word}</span>
                </span>
            `).join('');

            return `
                <section class="${cardClass}">
                    <div class="intonation-card-head">
                        <h3 class="${titleClass}">${title}</h3>
                        <span class="${accClass}">Accuracy ${stat.accuracy}%</span>
                    </div>
                    <div class="intonation-token-row">${tokenHtml}</div>
                    <p class="intonation-note">${note}</p>
                </section>
            `;
        }

        function buildMethodPanel(stat) {
            if (!stat) return '';
            const weakWords = stat.tokens
                .filter((t) => t.cls.stressed && !t.cls.accurate)
                .map((t) => String(t.word || '').toLowerCase());
            const overWords = stat.tokens
                .filter((t) => t.cls.overStress)
                .map((t) => String(t.word || '').toLowerCase());
            const uniqueWeak = [...new Set(weakWords)].filter(Boolean).slice(0, 3);
            const uniqueOver = [...new Set(overWords)].filter(Boolean).slice(0, 3);
            const focusText = uniqueWeak.length
                ? `Missed stress words: ${uniqueWeak.join(' / ')}`
                : uniqueOver.length
                    ? `Over-stressed light words: ${uniqueOver.join(' / ')}`
                    : 'Focus words: keep stress on key content words in each sentence.';
            const methodText = uniqueWeak.length
                ? 'Method: for each focus word, slow down slightly, lengthen the vowel by about 0.1-0.2 seconds, and add a small pitch rise.'
                : uniqueOver.length
                    ? 'Method: compress these light words, reduce loudness, and keep your strongest energy on nouns/verbs/adjectives.'
                    : 'Method: slightly lengthen stressed words by about 0.1-0.2 seconds and keep function words short. Keep 2-4 main stresses per sentence.';

            return `
                <section class="intonation-method">
                    <h4>How to Improve Stress</h4>
                    <p>${focusText}</p>
                    <p>${methodText}</p>
                </section>
            `;
        }

        function renderIntonationRhythm() {
            const root = document.getElementById('intonationRhythmRoot');
            if (!root) return;

            const words = {{ alignment.words | tojson | default('[]') }};
            if (!Array.isArray(words) || words.length === 0) {
                root.innerHTML = '<div class="intonation-empty">No intonation data available.</div>';
                return;
            }

            const sentences = splitIntoIntonationSentences(words).map(evaluateSentence);
            if (!sentences.length) {
                root.innerHTML = '<div class="intonation-empty">No analyzable sentences were found.</div>';
                return;
            }

            const { best, worst } = pickBestAndWorst(sentences);
            const html = [
                best ? buildCard(best, 'best') : '',
                worst ? buildCard(worst, 'warning') : '',
                worst ? buildMethodPanel(worst) : ''
            ].join('');

            root.innerHTML = html || '<div class="intonation-empty">No analyzable sentences were found.</div>';
        }
        
        window.openPronunciationModal = function() {
            document.getElementById('pronunciationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        window.closePronunciationModal = function() {
            document.getElementById('pronunciationModal').classList.remove('active');
            document.body.style.overflow = '';
        }

    </script>
    <!-- cleaned comment -->
    <div id="fluencyModal" class="modal-overlay">
