        .skill-card.intonation .skill-score { color: #00C853; }
        .skill-card.fluency .skill-score { color: #FF9100; }
        .skill-card.completeness .skill-score { color: #AA00FF; }
        
        .skill-label {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }
        
        .skill-level {
            font-size: 0.85rem;
