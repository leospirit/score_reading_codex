<!DOCTYPE html>
<html lang="zh-CN">
{% macro get_level(score) -%}
    {% if score >= 90 %}Advanced{% elif score >= 80 %}High-Intermediate{% elif score >= 70 %}Intermediate{% elif score >= 60 %}Basic{% else %}Beginner{% endif %}
{%- endmacro %}
{% macro score_int(value) -%}
    {{ (value | float) | round(0) | int }}
{%- endmacro %}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Speaking Score Report - {{ meta.student_name or meta.student_id }}</title>
    <!-- cleaned comment -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- cleaned comment -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Work+Sans:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-ok: #00C853;     /* Green */
            --color-weak: #FF9100;   /* Orange */
            --color-missing: #FF1744; /* Red */
            --color-poor: #AA00FF;    /* Purple */
            
            /* Light Theme */
            --bg-page: #F8FAFC;      /* cleaned comment */
            --bg-card: #ffffff;
            --text-primary: #1E293B; /* Slate-800 */
            --text-secondary: #64748B; /* Slate-500 */
            --accent: #2979FF;       /* Blue */
            --card-border: #E2E8F0;
            
            /* Gradients */
            --grad-overall: linear-gradient(135deg, #00E5FF 0%, #2979FF 100%);
            --grad-pronunciation: linear-gradient(to right, #2979FF, #448AFF);
            --grad-fluency: linear-gradient(to right, #FF9100, #FFB74D);
            --grad-intonation: linear-gradient(to right, #00C853, #69F0AE);
            --grad-completeness: linear-gradient(to right, #AA00FF, #EA80FC);
            
            /* Shadows (Soft UI) */
            --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
            --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            
            --font-heading: 'Outfit', sans-serif;
            --font-body: 'Work Sans', sans-serif;
            --font-text: 'Inter', sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-body);
            background: var(--bg-page);
            color: var(--text-primary);
            min-height: 100vh;
            padding: 20px;
        }
        
        h1, h2, h3, .number, .value, .skill-score {
            font-family: var(--font-heading);
        }
        
        .container {
            max-width: 800px; /* cleaned comment */
            margin: 0 auto;
        }
        
        /* cleaned comment */
        .header {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 16px 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-card);
            border: 1px solid rgba(0,0,0,0.02);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .header h1 {
            font-size: 1.2rem; /* cleaned comment */
            margin-bottom: 0;
            color: var(--accent);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 12px;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }
        
        .meta-item {
            display: flex;
            flex-direction: column;
        }
        
        .meta-item .label {
            font-size: 0.75rem;
            text-transform: uppercase;
            margin-bottom: 4px;
            opacity: 0.7;
        }
        
        .meta-item .value {
            color: var(--text-primary);
            font-weight: 500;
        }
        
        /* cleaned comment */
        .scores-section {
            display: grid;
            grid-template-columns: 200px 1fr; /* cleaned comment */
            gap: 20px;
            margin-bottom: 20px;
        }
        
        /* cleaned comment */
        .overall-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px;
            box-shadow: var(--shadow-card);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,0,0,0.02);
            height: 100%;
        }
        
        .ring-container {
            width: 140px; /* cleaned comment */
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .progress-ring__circle {
            transition: stroke-dashoffset 0.5s ease-in-out;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
            stroke-linecap: round;
            stroke-dasharray: var(--ring-circumference, 339);
            stroke-dashoffset: var(--ring-circumference, 339);
            animation: ringSweep 1100ms cubic-bezier(0.22, 1, 0.36, 1) 120ms forwards;
        }

        .ring-container.overall-main {
            position: relative;
            margin-bottom: 4px;
        }

        .overall-main .ring-center {
            width: 96px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0;
        }

        .overall-main .ring-center .value {
            font-size: 2.5rem;
            line-height: 1;
            margin-bottom: 0;
            letter-spacing: -0.8px;
        }

        @keyframes ringSweep {
            from { stroke-dashoffset: var(--ring-circumference, 339); }
            to { stroke-dashoffset: var(--ring-offset, 339); }
        }

        @media (prefers-reduced-motion: reduce) {
            .progress-ring__circle {
                animation: none !important;
                stroke-dashoffset: var(--ring-offset, 339);
            }
        }
        
        .ring-center .value {
            font-size: 2rem;
            margin-bottom: 2px;
        }

        .overall-feedback {
            text-align: center;
        }
        
        .overall-feedback h2 {
            display: none; /* cleaned comment */
        }
        
        .overall-feedback .level-badge {
            margin-bottom: 0;
            padding: 4px 10px;
            font-size: 0.8rem;
        }
        
        .overall-feedback p {
            display: none; /* cleaned comment */
        }

        /* cleaned comment */
        .breakdown-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            gap: 16px;
        }
        
        .skill-card {
            padding: 16px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .skill-score {
            font-size: 1.8rem; /* cleaned comment */
            margin: 4px 0;
        }
        
        .skill-label {
            font-size: 0.9rem;
        }
        
        .skill-level {
            font-size: 0.75rem;
        }
        
        @media (max-width: 768px) {
            .overall-card {
                flex-direction: column;
                text-align: center;
                padding: 24px;
            }
        }
        
        .ring-container {
            position: relative;
            width: 140px;
            height: 140px;
            flex-shrink: 0;
        }
        
        .ring-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }
        
        .ring-center .value {
            font-size: 2.6rem; /* cleaned comment */
            font-weight: 800;
            background: var(--grad-overall);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.1;
            margin-bottom: 4px;
            letter-spacing: -1px; /* cleaned comment */
        }
        
        .ring-center .unit {
            font-size: 0.65rem; /* cleaned comment */
            color: var(--text-secondary);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px; /* cleaned comment */
            opacity: 0.8;
            line-height: 1.2;
            max-width: 120px; /* cleaned comment */
            margin: 0 auto;
        }
        
        .overall-feedback {
            flex: 1;
        }
        
        .overall-feedback h2 {
            font-size: 1.8rem;
            margin-bottom: 10px;
            color: var(--text-primary);
        }
        
        .overall-feedback .level-badge {
            display: inline-block;
            padding: 4px 12px;
            background: rgba(41, 121, 255, 0.1);
            color: var(--accent);
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 12px;
        }
        
        .overall-feedback p {
            color: var(--text-secondary);
            line-height: 1.6;
            max-width: 600px;
        }
        
        /* cleaned comment */
        .breakdown-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }
        
        .skill-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--shadow-card);
            text-align: center;
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
            overflow: hidden;
            border-top: 4px solid transparent;
            border-bottom: 1px solid rgba(0,0,0,0.02);
            border-left: 1px solid rgba(0,0,0,0.02);
            border-right: 1px solid rgba(0,0,0,0.02);
        }
        
        .skill-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }
        
        .skill-card.pronunciation { border-top-color: #2979FF; }
        .skill-card.intonation { border-top-color: #00C853; }
        .skill-card.fluency { border-top-color: #FF9100; }
        .skill-card.completeness { border-top-color: #AA00FF; }
        
        .skill-score {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 10px 0;
            line-height: 1;
        }
        
        .skill-card.pronunciation .skill-score { color: #2979FF; }
        .skill-card.intonation .skill-score { color: #00C853; }
        .skill-card.fluency .skill-score { color: #FF9100; }
        .skill-card.completeness .skill-score { color: #AA00FF; }
        
        .skill-label {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }
        
        .skill-level {
            font-size: 0.85rem;
            color: var(--text-secondary);
        }
        

        
        /* cleaned comment */
        .text-section {
            background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFF 100%);
            border-radius: 18px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-card);
            border: 1px solid var(--card-border);
            border-top: 4px solid #2979FF;
        }
        
        .text-section h2 {
            font-size: 1.22rem;
            margin-bottom: 0;
            color: #1E40AF;
            letter-spacing: 0.01em;
        }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .section-head .section-meta {
            font-size: 0.78rem;
            color: #475569;
            background: #E8F0FF;
            border: 1px solid #C7DAFF;
            border-radius: 999px;
            padding: 2px 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .reading-audio {
            height: 36px;
            border-radius: 18px;
            background: #F8FAFC;
            border: 1px solid #D1E0F7;
            padding: 0 4px;
        }
        
        .highlighted-text {
            font-family: var(--font-text);
            font-size: 1.05rem; /* cleaned comment */
            line-height: 1.8;   /* cleaned comment */
            padding: 20px 22px;
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            text-align: justify;
        }
        
        .highlighted-text .word {
            padding: 2px 8px;
            border-radius: 8px;
            margin: 0 2px;
            display: inline-block;
            cursor: pointer;
            transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, border-color 0.16s ease;
            position: relative;
            border: 1px solid transparent;
        }
        
        .highlighted-text .word:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 14px rgba(15, 23, 42, 0.12);
        }
        
        .highlighted-text .word.playing {
            animation: wordPulse 0.3s ease-in-out infinite alternate;
        }
        
        @keyframes wordPulse {
            from { transform: scale(1); box-shadow: 0 0 5px currentColor; }
            to { transform: scale(1.1); box-shadow: 0 0 15px currentColor; }
        }
        
        .highlighted-text .word.ok {
            /* cleaned comment */
            background: transparent;
            color: var(--text-primary);
        }
        
        .highlighted-text .word.weak {
            /* cleaned comment */
            background: #FFF7ED;
            color: #C2410C;
            border-color: #FDBA74;
            font-weight: 600;
        }
        
        .highlighted-text .word.poor {
            /* cleaned comment */
            background: #FEF2F2;
            color: #B91C1C;
            border-color: #FCA5A5;
            font-weight: 600;
        }
        
        .highlighted-text .word.missing {
            /* cleaned comment */
            background: #FFE4E6;
            color: #9F1239;
            font-weight: 600;
            border-color: #FDA4AF;
            opacity: 0.95;
        }

        .highlighted-text .word.missing .missing-box {
            display: inline-block;
            min-width: 24px;
            text-align: center;
            margin-right: 4px;
            padding: 0 4px;
            border-radius: 4px;
            background: #FCE7F3;
            color: #9D174D;
            border: 1px solid #F9A8D4;
            font-weight: 700;
            line-height: 1.2;
        }

        .highlighted-text .word.missing .missing-text {
            text-decoration: line-through;
            text-decoration-thickness: 2px;
        }

        .highlighted-text .word.pause-flagged {
            font-weight: 700;
        }

        .highlighted-text .word.pause-too-long {
            background: #FFE4E6;
            color: #9F1239;
            box-shadow: inset 0 -2px 0 #F43F5E;
        }

        .highlighted-text .word.pause-phrase-break {
            background: #FEE2E2;
            color: #991B1B;
            box-shadow: inset 0 -2px 0 #EF4444;
        }

        .highlighted-text .word.pause-too-short {
            background: #FFFBEB;
            color: #92400E;
            box-shadow: inset 0 -2px 0 #F59E0B;
        }

        .word-factor-pop {
            position: absolute;
            left: 50%;
            bottom: calc(100% + 10px);
            transform: translateX(-50%) translateY(4px);
            min-width: 180px;
            max-width: 280px;
            padding: 8px 10px;
            border-radius: 8px;
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.18);
            z-index: 30;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.14s ease, transform 0.14s ease;
        }

        .highlighted-text .word:hover .word-factor-pop {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

        .word-factor-pop::after {
            content: '';
            position: absolute;
            left: 50%;
            bottom: -6px;
            width: 10px;
            height: 10px;
            background: #FFFFFF;
            border-right: 1px solid #E2E8F0;
            border-bottom: 1px solid #E2E8F0;
            transform: translateX(-50%) rotate(45deg);
        }

        .word-factor-head {
            display: block;
            font-size: 0.9rem;
            color: #0F172A;
            margin-bottom: 4px;
            white-space: nowrap;
        }

        .word-factor-grid {
            display: grid;
            grid-auto-flow: column;
            grid-auto-columns: minmax(18px, auto);
            gap: 6px;
            align-items: center;
            justify-content: start;
            margin: 2px 0;
        }

        .word-factor-cell {
            text-align: center;
            font-size: 0.84rem;
            color: #111827;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        .word-factor-grid.scores .word-factor-cell {
            color: #0F766E;
            font-weight: 700;
        }

        .break-chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 6px 0 2px;
            padding: 2px 8px;
            min-height: 20px;
            border-radius: 999px;
            font-size: 0.64rem;
            line-height: 1;
            font-weight: 800;
            letter-spacing: 0.02em;
            vertical-align: middle;
            border: 1px solid transparent;
            text-transform: uppercase;
        }

        .break-chip.unexpected {
            background: #FEE2E2;
            color: #991B1B;
            border-color: #EF4444;
            box-shadow: 0 0 0 1px rgba(153, 27, 27, 0.08);
        }

        .break-chip.unexpected.phrase-break {
            background: #FFE4E6;
            color: #9F1239;
            border-color: #FB7185;
        }

        .break-chip.missing {
            background: #FFFBEB;
            color: #92400E;
            border-color: #FBBF24;
        }
        
        /* cleaned comment */
        .bottom-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .analysis-section, .feedback-section {
            margin-bottom: 0; /* cleaned comment */
            padding: 20px;
            border-radius: 12px;
        }

        .analysis-section h2, .text-section h2, .feedback-section h2 {
            font-size: 1.1rem;
            margin-bottom: 12px;
        }
        
        /* cleaned comment */
        @media print {
            body {
                background: white;
                padding: 0;
            }
            .container {
                width: 100%;
                max-width: none;
                box-shadow: none;
            }
            .print-btn, .score-toggle-btn { display: none; }
            .ring-center .value {
                background: none !important;
                -webkit-background-clip: border-box !important;
                -webkit-text-fill-color: #0F172A !important;
                color: #0F172A !important;
            }
            .ring-center .unit {
                color: #334155 !important;
                opacity: 1 !important;
            }
            .overall-main .progress-ring__circle {
                animation: none !important;
                stroke-dashoffset: var(--ring-offset, 339) !important;
            }
            .pause-guide-tag.inline[data-print-hint]::after {
                content: " (" attr(data-print-hint) ")";
                font-size: 0.66rem;
                font-weight: 600;
                color: #475569;
                margin-left: 2px;
            }
            .transcription-section {
                display: none !important;
            }
        }
        
        .print-btn {
            background: var(--accent);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-family: var(--font-body);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }
        .print-btn:hover {
            background: #2962FF;
        }

        .score-toggle-btn {
            background: #fff;
            color: var(--text-primary);
            border: 1px solid #CBD5E1;
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.84rem;
            transition: all 0.2s;
        }
        .score-toggle-btn:hover {
            border-color: #94A3B8;
            background: #F8FAFC;
        }
        
        .reading-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
        }

        .reading-legend .legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 10px;
            border: 1px solid transparent;
            font-size: 0.79rem;
            font-weight: 700;
            line-height: 1.1;
            white-space: nowrap;
        }

        .reading-legend .legend-item.ok {
            color: var(--text-primary);
            background: rgba(15, 23, 42, 0.06);
        }

        .reading-legend .legend-item.weak {
            color: var(--color-weak);
            background: rgba(245, 158, 11, 0.18);
        }

        .reading-legend .legend-item.poor {
            color: var(--color-missing);
            background: rgba(239, 68, 68, 0.16);
        }

        .reading-legend .legend-item.missing {
            color: var(--color-missing);
            text-decoration: line-through;
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.28);
            opacity: 0.92;
        }

        .reading-legend .legend-item.break-unexpected {
            color: #991B1B;
            background: #FEE2E2;
            border-color: #FCA5A5;
        }

        .reading-legend .legend-item.break-phrase {
            color: #9F1239;
            background: #FFE4E6;
            border-color: #FDA4AF;
        }

        .reading-legend .legend-item.break-missing {
            color: #92400E;
            background: #FFFBEB;
            border-color: #FCD34D;
        }

        /* cleaned comment */
        .link-arc {
            display: inline-block;
            vertical-align: bottom;
            margin: 0 -8px; /* cleaned comment */
            color: var(--accent);
            opacity: 0.8;
            pointer-events: none;
            width: 20px;
            height: 10px;
        }
        
        .word.weak[data-diagnosis]:after, .word.poor[data-diagnosis]:after {
            content: " *";
            font-size: 0.7em;
            vertical-align: super;
            opacity: 0.8;
        }

        /* cleaned comment */
        .transcription-section {
            background: #F8FAFC;
            border-left: 4px solid #3B82F6;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 24px;
        }

        .transcription-summary {
            font-size: 0.95rem;
            color: #1E293B;
            margin-bottom: 0;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            font-weight: 700;
            list-style: none;
            user-select: none;
        }

        .transcription-summary::-webkit-details-marker {
            display: none;
        }
        .transcription-summary::before {
            content: ">";
            color: #3B82F6;
            font-size: 0.9rem;
            line-height: 1;
            transform: translateY(-1px);
        }
        .transcription-section[open] .transcription-summary::before {
            content: "v";
        }

        .transcription-body {
            margin-top: 10px;
        }
        
        .detected-content {
            font-family: var(--font-mono);
            font-size: 1rem;
            line-height: 1.6;
            color: #475569;
            background: #FFFFFF;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #E2E8F0;
            white-space: pre-wrap;
        }
        
        .detected-content mark {
            background: #FEE2E2;
            color: #B91C1C;
            padding: 0 2px;
            border-radius: 2px;
            font-weight: 600;
        }

        /* cleaned comment */
        .analysis-section {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-card);
            border: 1px solid var(--card-border);
        }
        
        .analysis-section h2 {
            font-size: 1.2rem;
            margin-bottom: 16px;
            color: var(--accent);
        }
        
        .analysis-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }
        
        .analysis-card {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 16px;
        }
        
        .analysis-card h3 {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }
        
        .analysis-card .items {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .analysis-card .item {
            background: #EEF2FF;
            border: 1px solid #DBEAFE;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: transform 0.16s ease, box-shadow 0.16s ease;
        }
        
        .analysis-card .item:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 10px rgba(15, 23, 42, 0.08);
        }
        
        .analysis-card .item.weak {
            background: rgba(255, 193, 7, 0.2);
            color: var(--color-weak);
        }
        
        .analysis-card .item.missing {
