</head>
<body>
    <div class="container">
        <!-- cleaned comment -->
        <div class="header">
            <h1>Speaking Report - {{ meta.student_id }}</h1>
            <button class="print-btn" onclick="window.print()">Generate Report</button>
        </div>
        
        <!-- cleaned comment -->
        <div class="scores-section">
            <!-- cleaned comment -->
            <div class="overall-card">
                <div class="ring-container" style="transform: scale(0.9); margin-bottom: -10px;">
                    <svg class="progress-ring" width="120" height="120">
                        <circle
                            class="progress-ring__circle-bg"
                            stroke="#e6e6e6"
                            stroke-width="10"
                            fill="transparent"
                            r="54"
                            cx="60"
                            cy="60"/>
                        <circle
                            class="progress-ring__circle"
                            stroke="url(#gradient)"
                            stroke-width="10"
                            fill="transparent"
                            r="54"
                            cx="60"
                            cy="60"
                            style="stroke-dasharray: 339; stroke-dashoffset: {{ 339 - (339 * scores.overall_100 / 100) }}"/>
                        <defs>
                            <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#00E5FF" />
                                <stop offset="100%" stop-color="#2979FF" />
                            </linearGradient>
                        </defs>
                    </svg>
                    <div class="ring-center">
                        <div class="value" style="font-size: 2rem;">{{ score_int(scores.overall_100) }}%</div>
                        <div class="unit">{{ get_level(scores.overall_100) }}</div>
                    </div>
                </div>
                <div class="overall-feedback">
                    <h2>Overall Speaking Score</h2>
                    <span class="level-badge">Current Level: {{ get_level(scores.overall_100) }}</span>
                    <p>Your speaking performance is solid. Keep practicing and focus on smoother rhythm and more natural pauses.</p>
                </div>
            </div>
            
            <!-- cleaned comment -->
            <div class="breakdown-grid">
                <div class="skill-card pronunciation" onclick="openPronunciationModal()" style="cursor: pointer;">
                    <div class="skill-score">{{ score_int(scores.pronunciation_100) }}%</div>
                    <div class="skill-label">Pronunciation</div>
                    <div class="skill-level">{{ get_level(scores.pronunciation_100) }}</div>
                </div>
                
                <div class="skill-card intonation" onclick="openIntonationModal()" style="cursor: pointer;">
                    <div class="skill-score">{{ score_int(scores.intonation_100) }}%</div>
                    <div class="skill-label">Prosody</div>
                    <div class="skill-level">{{ get_level(scores.intonation_100) }}</div>
                </div>
                
                <div class="skill-card fluency" onclick="openFluencyModal()" style="cursor: pointer;">
                    <div class="skill-score">{{ score_int(scores.fluency_100) }}%</div>
                    <div class="skill-label">Fluency</div>
                    <div class="skill-level">{{ get_level(scores.fluency_100) }}</div>
                </div>
                
                <div class="skill-card completeness" onclick="openCompletenessModal()" style="cursor: pointer;">
                    <div class="skill-score">{{ score_int(scores.completeness_100) }}%</div>
                    <div class="skill-label">Completeness</div>
                    <div class="skill-level">{{ get_level(scores.completeness_100) }}</div>
                </div>
            </div>
        </div>
        

        
        <!-- cleaned comment -->
        {% if engine_raw.detected_transcript %}
        <div class="transcription-section">
            <h3>Transcript Comparison</h3>
            <div class="detected-content">{{ engine_raw.detected_transcript }}</div>
            <p style="font-size: 0.8rem; color: #64748B; margin-top: 8px;">
                <b>提示：</b>这是实际听到的内容。若与参考文本不一致，请优先关注高亮差异。
        </div>
        {% endif %}

        {% set _pause_profile = engine_raw.pause_profile if engine_raw and engine_raw.pause_profile else {} %}
        {% set show_missing_break = not ((_pause_profile.synthetic_timeline | default(0) | float >= 0.5) or (_pause_profile.low_confidence_timing | default(0) | float >= 0.5) or ((_pause_profile.timing_confidence | default('') | lower) == 'low')) %}
        <!-- cleaned comment -->
        <div class="text-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h2 style="margin-bottom: 0;">Reading Analysis</h2>
                {% if audio_base64 %}
                <audio controls style="height: 36px; border-radius: 18px;">
                    <source src="data:audio/mp3;base64,{{ audio_base64 }}" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
                {% endif %}
            </div>
            <div class="highlighted-text" id="highlightedText">
                {% for word in alignment.words %}
                {% if not loop.first and loop.previtem.pause %}
                    {% if loop.previtem.pause.type == 'bad' %}
                    <span class="break-chip unexpected" title="Unexpected break before this word">UB</span>
                    {% elif show_missing_break and loop.previtem.pause.type == 'missed' %}
                    <span class="break-chip missing" title="Missing break before this word">MB</span>
                    {% endif %}
                {% endif %}
                <span class="word {{ word.tag }}" 
                      title="{% if word.diagnosis %}Diagnosis: {{ word.diagnosis }}{% else %}Score: {{ ('%.1f' % (word.score | float)).rstrip('0').rstrip('.') }}{% endif %}"
                      data-start="{{ word.start }}"
                      data-end="{{ word.end }}"
                      data-index="{{ loop.index0 }}"
                      {% if word.diagnosis %}data-diagnosis="{{ word.diagnosis }}"{% endif %}>
                    {% if word.tag == 'missing' %}
                    <span class="missing-box">[ ]</span><span class="missing-text">{{ word.word }}</span>
                    {% else %}
                    {{ word.word }}
                    {% endif %}
                    {% if word.phoneme_breakdown %}
                    <span class="word-factor-pop">
                        <span class="word-factor-head">{{ word.word }} : {{ score_int(word.score) }}</span>
                        <span class="word-factor-grid symbols">
                            {% for ph in word.phoneme_breakdown %}
                            <span class="word-factor-cell">{{ ph.symbol }}</span>
                            {% endfor %}
                        </span>
                        <span class="word-factor-grid scores">
                            {% for ph in word.phoneme_breakdown %}
                            <span class="word-factor-cell">{{ score_int(ph.score) }}</span>
                            {% endfor %}
                        </span>
                    </span>
                    {% endif %}
                </span>
                {% endfor %}
            </div>
            <div class="legend">
                <span class="legend-item ok">Correct</span>
                <span class="legend-item weak">Weak</span>
                <span class="legend-item poor">Needs Improvement</span>
                <span class="legend-item missing">Missing</span>
                <span class="legend-item break-unexpected" title="Unexpected break">UB</span>
                {% if show_missing_break %}
                <span class="legend-item break-missing" title="Missing break">MB</span>
                {% else %}
                <span class="legend-item break-missing" title="Missing break hidden on low-confidence timing">MB off</span>
                {% endif %}
            </div>
        </div>
        
        <!-- cleaned comment -->
        <div class="bottom-row">
            <!-- cleaned comment -->
            <div class="analysis-section">
                <h2>Key Focus</h2>
                <div class="analysis-grid" style="grid-template-columns: 1fr;">
                    {% if analysis.weak_words %}
                    <div class="analysis-card" style="padding: 10px;">
                        <h3 style="margin-bottom: 4px;">Words to improve</h3>
                        <div class="items">
                            {% for word in analysis.weak_words[:5] %}
                            <span class="item weak" data-word="{{ word }}">{{ word }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                    
                    {% if analysis.missing_words %}
                    <div class="analysis-card" style="padding: 10px;">
                        <h3 style="margin-bottom: 4px;">Missing words</h3>
                        <div class="items">
                            {% for word in analysis.missing_words[:5] %}
                            <span class="item missing" data-word="{{ word }}">{{ word }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- cleaned comment -->
            <div class="feedback-section">
                <h2>Integrated Feedback</h2>
                <div class="feedback-content" style="font-size: 0.9rem;">
                    <p style="margin-bottom: 8px;">{{ feedback.cn_summary }}</p>
                    <ul class="action-list">
                        {% for action in feedback.cn_actions[:2] %}
                        <li>{{ action }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- cleaned comment -->
        {% if phoneme_tips %}
        <div class="pronunciation-section">
            <h2>Pronunciation Guidance</h2>
            <div class="phoneme-cards">
                {% for tip in phoneme_tips %}
                <div class="phoneme-card">
                    <div class="phoneme-title">
                        <span class="phoneme-symbol">/{{ tip.phoneme }}/</span>
                        <span class="phoneme-name">{{ tip.name }}</span>
                    </div>
                    <div class="examples">
                        {% for example in tip.examples %}
                        <span class="example-word">{{ example }}</span>
                        {% endfor %}
                    </div>
                    <div class="tip">{{ tip.advice }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        
        <!-- cleaned comment -->


        <!-- cleaned comment -->
        {% if (feedback.cn_summary or feedback.cn_actions) and not advisor_feedback %}
        <div class="feedback-section">
            <h2>Improvement Suggestions</h2>
            {% if feedback.cn_summary %}
            <div class="feedback-summary">
                {{ feedback.cn_summary }}
            </div>
            {% endif %}
            
            {% if feedback.cn_actions %}
            <div class="feedback-actions">
                <h3>Action Plan</h3>
                <ol>
                    {% for action in feedback.cn_actions %}
                    <li>{{ action }}</li>
                    {% endfor %}
                </ol>
            </div>
            {% endif %}
            
            {% if feedback.practice %}
            <div class="practice-words">
                {% for pair in feedback.practice %}
                <span class="practice-word">{{ pair }}</span>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}
        
    </div>

    <!-- cleaned comment -->
    <div id="pronunciationModal" class="modal-overlay">
        <div class="modal-container" style="max-width: 900px;">
            <div class="modal-header">
                <h2>Pronunciation Details (Pronunciation)</h2>
                <button class="close-btn" onclick="closePronunciationModal()">&times;</button>
            </div>
            <div class="modal-body">
                <!-- cleaned comment -->
                <div class="pro-header">
                    <div class="ring-container small">
                         <!-- cleaned comment -->
                         <div class="ring-center">
                            <div class="value" style="font-size: 1.8rem; color: #2979FF;">{{ score_int(scores.pronunciation_100) }}%</div>
                            <div class="unit">{{ get_level(scores.pronunciation_100) }}</div>
                        </div>
                    </div>
                    <div class="pro-status">
                        <h3>Pronunciation Performance: {{ get_level(scores.pronunciation_100) }}</h3>
                        <p>Please focus on the phoneme issues listed below. They are key to raising your score.</p>
                    </div>
                </div>

                <h3 style="margin: 20px 0 16px; color: #1E293B;">Core Pronunciation Diagnostics (Top Errors)</h3>

                <!-- cleaned comment -->
                <div class="phoneme-analysis-grid">
                    {% if advisor_feedback and advisor_feedback.top_errors %}
                        {% for error in advisor_feedback.top_errors %}
                        <div class="elsa-card">
                            <div class="elsa-card-header">
                                Sound {{ error.phoneme if error.phoneme else 'Key Sound' }}
                            </div>
                            <div class="elsa-card-body">
                                <div class="elsa-section-title">Words with Mistakes</div>
                                <div class="elsa-mistake-item">
                                    <div class="elsa-mistake-text">{{ error.description if error.description else 'Detected pronunciation instability on key words.' }}</div>
                                    <ul class="elsa-word-list">
                                        {% if error.words and error.words|length > 0 %}
                                            {% for w_name in error.words %}
                                            <li class="elsa-word-item" 
                                                onclick="jumpToWord('{{ w_name }}')"
                                                style="cursor: pointer;">
                                                {{ w_name }}
                                                {% for w in alignment.words if w.word.lower() == w_name.lower() and w.diagnosis %}
                                                <span style="display:block; font-size: 0.8rem; font-weight: normal; color: #DC2626; margin-top:2px;">
                                                    Diagnosis: {{ w.diagnosis }}
                                                </span>
                                                {% endfor %}
                                            </li>
                                            {% endfor %}
                                        {% else %}
                                            <li class="elsa-word-item" style="cursor: default; opacity: 0.75;">
                                                No specific words identified in this pass.
                                            </li>
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                            <div class="elsa-card-footer">
                                <div class="elsa-section-title">How to Improve</div>
                                <div class="elsa-improvement-tip">{{ error.improvement if error.improvement else 'Slow down slightly and keep stressed vowels full; finish word endings clearly.' }}</div>
                            </div>
                        </div>
                        {% endfor %}
                    {% elif pronunciation_analysis and pronunciation_analysis|length > 0 %}
                        {% for pa in pronunciation_analysis[:3] %}
                        {% set first_mistake = pa.mistakes[0] if pa.mistakes else None %}
                        <div class="elsa-card">
                            <div class="elsa-card-header">
                                Sound {{ pa.target if pa.target else 'Key Word' }}
                            </div>
                            <div class="elsa-card-body">
                                <div class="elsa-section-title">Words with Mistakes</div>
                                <div class="elsa-mistake-item">
                                    <div class="elsa-mistake-text">
                                        {{ first_mistake.actual if first_mistake and first_mistake.actual else 'Detected pronunciation instability on key words.' }}
                                    </div>
                                    <ul class="elsa-word-list">
                                        {% if first_mistake and first_mistake.words %}
                                            {% for w_obj in first_mistake.words[:5] %}
                                            {% set w_name = w_obj.text if w_obj.text is defined else (w_obj if w_obj is string else '') %}
                                            {% if w_name %}
                                            <li class="elsa-word-item" onclick="jumpToWord('{{ w_name }}')" style="cursor: pointer;">
                                                {{ w_name }}
                                            </li>
                                            {% endif %}
                                            {% endfor %}
                                        {% else %}
                                            {% for w_name in analysis.weak_words[:5] %}
                                            <li class="elsa-word-item" onclick="jumpToWord('{{ w_name }}')" style="cursor: pointer;">
                                                {{ w_name }}
                                            </li>
                                            {% endfor %}
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                            <div class="elsa-card-footer">
                                <div class="elsa-section-title">How to Improve</div>
                                <div class="elsa-improvement-tip">
                                    {{ first_mistake.desc if first_mistake and first_mistake.desc else 'Slow down slightly and keep stressed vowels full; finish word endings clearly.' }}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <div style="grid-column: 1/-1; padding: 40px; text-align: center; color: #64748B;">
                            Pronunciation details are being prepared. Please refresh this report in a few seconds.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    
    <!-- cleaned comment -->
        <div id="intonationModal" class="modal-overlay">
        <div class="modal-container" style="max-width: 980px;">
            <div class="modal-header">
                <h2>Prosody Analysis (Stress & Rhythm)</h2>
                <button class="close-btn" onclick="closeIntonationModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="intonation-legend-row">
                    <span class="legend-pill"><span class="legend-dot ok"></span>Stress Correct</span>
                    <span class="legend-pill"><span class="legend-dot bad"></span>Stress Incorrect</span>
                    <span class="legend-pill"><span class="legend-dot light"></span>Unstressed</span>
                </div>
                <div id="intonationRhythmRoot" class="intonation-rhythm-root">
                    <div class="intonation-empty">Generating intonation stress analysis...</div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .intonation-legend-row {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .legend-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
            color: #475569;
            font-weight: 600;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

        .legend-dot.ok { background: #19C37D; }
        .legend-dot.bad { background: #E55353; }
        .legend-dot.light { background: #CBD5E1; }

        .intonation-rhythm-root {
            display: grid;
            gap: 16px;
        }

        .intonation-empty {
            background: #F8FAFC;
            border: 1px dashed #CBD5E1;
            border-radius: 12px;
            padding: 18px;
            color: #64748B;
            font-size: 0.95rem;
            text-align: center;
        }

        .intonation-card {
            border-radius: 16px;
            border: 1px solid #E2E8F0;
            padding: 18px 20px 16px;
        }

        .intonation-card.best {
            background: linear-gradient(135deg, #E6F8EE 0%, #D8F3E3 100%);
            border-color: #A7E8C3;
        }

        .intonation-card.warning {
            background: linear-gradient(135deg, #FCEEEE 0%, #FBE7E7 100%);
            border-color: #F5B8B8;
        }

        .intonation-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
            gap: 10px;
            flex-wrap: wrap;
        }

        .intonation-title {
            font-size: 1.65rem;
            font-weight: 800;
            letter-spacing: -0.3px;
            margin: 0;
        }

        .intonation-title.best { color: #0F7A49; }
        .intonation-title.warning { color: #C0392B; }

        .intonation-acc {
            font-size: 0.95rem;
            font-weight: 800;
            border-radius: 999px;
            padding: 5px 12px;
        }

        .intonation-acc.best {
            color: #087444;
            background: rgba(16, 185, 129, 0.16);
        }

        .intonation-acc.warning {
            color: #B42318;
            background: rgba(229, 83, 83, 0.14);
        }

        .intonation-token-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 16px;
            margin-bottom: 10px;
        }

        .intonation-token {
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .stress-bubble {
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 3px 10px rgba(15, 23, 42, 0.12);
        }

        .stress-bubble.stressed {
            width: 26px;
            height: 26px;
        }

        .stress-bubble.light {
            width: 14px;
            height: 14px;
            box-shadow: none;
        }

        .stress-bubble.ok { background: #19C37D; }
        .stress-bubble.bad { background: #E55353; }
        .stress-bubble.silver { background: #CBD5E1; }

        .intonation-word {
            font-size: 1.02rem;
            color: #334155;
            font-weight: 600;
            line-height: 1;
        }

        .intonation-word.bad {
            color: #D42F2F;
            font-weight: 800;
        }

        .intonation-note {
            font-size: 0.96rem;
            font-weight: 650;
            margin: 0;
            color: #1E293B;
        }

        .intonation-method {
            border-radius: 14px;
            border: 1px solid #F5B8B8;
            background: #FFF8F8;
            padding: 14px 16px;
        }

        .intonation-method h4 {
            margin: 0 0 6px;
            color: #B42318;
            font-size: 1.02rem;
            font-weight: 800;
        }

        .intonation-method p {
            margin: 0 0 6px;
            color: #7A2E2E;
            line-height: 1.55;
            font-size: 0.95rem;
        }

        .intonation-method p:last-child { margin-bottom: 0; }

        @media (max-width: 768px) {
            .intonation-card { padding: 14px 14px 12px; }
            .intonation-title { font-size: 1.3rem; }
            .intonation-token-row { gap: 8px 11px; }
            .intonation-word { font-size: 0.96rem; }
            .stress-bubble.stressed { width: 22px; height: 22px; }
            .stress-bubble.light { width: 12px; height: 12px; }
        }
    </style>
<!-- cleaned comment -->
        <div class="footer">
            <p>Generated by AI Speech Scoring System | Submission ID: {{ meta.submission_id }}</p>
