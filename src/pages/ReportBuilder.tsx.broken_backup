function toIpaSymbol(input: string): string {
    const raw = String(input || '').trim();
    if (!raw) return '';
    const core = raw.replace(/^[\[/]+|[\]/]+$/g, '').trim();
    if (!core) return '';
    if (/[闁藉啫宕换鏍嫼閿曚焦鎳愰柦鍐攰閹界敻鎷戦幑鎰嚐闁荤喓鍠曢弳宸寀e闁煎啿鍟崯瀣嫼濞戞粍娈柤瑙勫姈濡惧ジ宕氶悩鐑橈紜]/.test(core)) return core;

    const arpabet = core.toUpperCase().replace(/\d+$/, '');
    if (ARPABET_TO_IPA[arpabet]) return ARPABET_TO_IPA[arpabet];

    const lower = core.toLowerCase();
    if (PSEUDO_TO_IPA[lower]) return PSEUDO_TO_IPA[lower];

    if (lower.length === 1 && LETTER_TO_IPA[lower]) return LETTER_TO_IPA[lower];
    return core;
}

function buildWordPhonemeBreakdown(data: ReportData | null): Record<number, WordPhonemeCell[]> {
    const out: Record<number, WordPhonemeCell[]> = {};
    if (!data) return out;
    const words = data.alignment?.words || [];
    const phonemes = data.alignment?.phonemes || [];
    words.forEach((_, i) => { out[i] = []; });
    if (!words.length || !phonemes.length) return out;

    const assigned = new Array(phonemes.length).fill(false);

    phonemes.forEach((p, pi) => {
        const symbol = toIpaSymbol(String(p.phoneme || '').trim());
        const ps = Number(p.start);
        const pe = Number(p.end);
        if (!symbol || !Number.isFinite(ps) || !Number.isFinite(pe) || pe <= ps) return;

        let bestIdx = -1;
        let bestOverlap = 0;
        words.forEach((w, wi) => {
            const ws = Number(w.start);
            const we = Number(w.end);
            if (!Number.isFinite(ws) || !Number.isFinite(we) || we <= ws) return;
            const overlap = Math.min(we, pe) - Math.max(ws, ps);
            if (overlap > bestOverlap) {
                bestOverlap = overlap;
                bestIdx = wi;
            }
        });

        if (bestIdx >= 0 && bestOverlap > 0.003) {
            out[bestIdx].push({ symbol, score: Number(p.score || 0), start: ps });
            assigned[pi] = true;
        }
    });

    const tokenSlots = new Map<string, number[]>();
    words.forEach((w, wi) => {
        const token = normalizeToken(w.word);
        if (!token) return;
        const arr = tokenSlots.get(token) || [];
        arr.push(wi);
        tokenSlots.set(token, arr);
    });
    const tokenCursor = new Map<string, number>();

    phonemes.forEach((p, pi) => {
        if (assigned[pi]) return;
        const symbol = toIpaSymbol(String(p.phoneme || '').trim());
        if (!symbol) return;
        const token = normalizeToken(String(p.in_word || ''));
        const slots = tokenSlots.get(token);
        if (!slots || !slots.length) return;
        const cursor = tokenCursor.get(token) || 0;
        const targetIdx = slots[Math.min(cursor, slots.length - 1)];
        tokenCursor.set(token, cursor + 1);
        out[targetIdx].push({ symbol, score: Number(p.score || 0), start: Number(p.start || 0) });
    });

    Object.values(out).forEach((row) => row.sort((a, b) => a.start - b.start));
    return out;
}

function buildWordDetailData(
    word: ReportData['alignment']['words'][number],
    idx: number,
    breakdown: Record<number, WordPhonemeCell[]>,
): WordDetailData {
    const baseScore = Math.round(Number(word.score || 0));
    const row = breakdown[idx] || [];
    if (row.length > 0) {
        const symbols = row.map((r) => r.symbol).join('  ');
        const scores = row.map((r) => String(Math.round(Number(r.score || 0)))).join('  ');
        return {
            header: `${word.word} : ${baseScore}`,
            symbols,
            scores,
        };
    }

    const pauseScoreMap: Record<string, number> = {
        good: 92,
        optional: 76,
        bad: 38,
        missed: 42,
        none: 82,
    };
    const stabilityMap: Record<string, number> = {
        ok: 90,
        weak: 72,
        poor: 48,
        missing: 20,
    };
    const pauseType = String(word.pause?.type || 'none');
    const pauseScore = pauseScoreMap[pauseType] ?? 70;
    const stability = stabilityMap[String(word.tag || '').toLowerCase()] ?? 70;
    return {
        header: `${word.word} : ${baseScore}`,
        fallbackRows: [
        `Pronunciation ${baseScore}`,
        `Pause impact ${pauseScore}`,
        `Stability ${stability}`,
        ],
    };
}

function formatScoreCompact(value: number, digits = 1): string {
    const n = Number(value);
    if (!Number.isFinite(n)) return '--';
    const factor = Math.pow(10, digits);
    const rounded = Math.round(n * factor) / factor;
    if (Number.isInteger(rounded)) return String(Math.trunc(rounded));
    return rounded.toFixed(digits).replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
}

function isLowConfidenceTimeline(words: ReportData['alignment']['words']): boolean {
    if (!Array.isArray(words) || words.length < 7) return false;
    const gaps: number[] = [];
    for (let i = 0; i < words.length - 1; i += 1) {
        const left = Number(words[i]?.end);
        const right = Number(words[i + 1]?.start);
        if (!Number.isFinite(left) || !Number.isFinite(right)) continue;
        gaps.push(Math.max(0, right - left));
    }
    if (gaps.length < 6) return false;
    const sorted = [...gaps].sort((a, b) => a - b);
    const median = sorted[Math.floor(sorted.length / 2)];
    const near = gaps.filter((g) => Math.abs(g - median) <= 0.02).length / Math.max(1, gaps.length);
    const mean = gaps.reduce((s, g) => s + g, 0) / gaps.length;
    const variance = gaps.reduce((s, g) => s + (g - mean) * (g - mean), 0) / Math.max(1, gaps.length);
    const std = Math.sqrt(variance);
    if (median >= 0.07 && median <= 0.16 && near >= 0.65) return true;
    if (median <= 0.20 && std <= 0.02 && near >= 0.55) return true;
    return false;
}

